package com.example.employeetimeclock

import android.content.Intent
import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity

class LoginActivity : AppCompatActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_login)

        val emailEditText = findViewById<EditText>(R.id.emailEditText)
        val passwordEditText = findViewById<EditText>(R.id.passwordEditText)
        val loginButton = findViewById<Button>(R.id.loginButton)
        val registerText = findViewById<TextView>(R.id.registerText)
        val forgotPasswordText = findViewById<TextView>(R.id.forgotPasswordText)

        loginButton.setOnClickListener {
            val email = emailEditText.text.toString().trim()
            val password = passwordEditText.text.toString().trim()

            if (email.isEmpty() || password.isEmpty()) {
                Toast.makeText(this, "Please fill in all fields", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            DataManager.getInstance().seedDemoData()

            val employee = DataManager.getInstance().getEmployees().firstOrNull { it.email == email }
            if (employee != null) {
                val targetActivity = if (employee.role == "manager") ManagerActivity::class.java else MainActivity::class.java
                val intent = Intent(this, targetActivity)
                intent.putExtra("employeeId", employee.id)
                intent.putExtra("employeeName", employee.name)
                intent.putExtra("role", employee.role)
                startActivity(intent)
                finish()
            } else {
                Toast.makeText(this, "Invalid email or password", Toast.LENGTH_SHORT).show()
            }
        }

        registerText.setOnClickListener {
            val intent = Intent(this, RegisterActivity::class.java)
            startActivity(intent)
        }

        forgotPasswordText.setOnClickListener {
            val intent = Intent(this, ForgotPasswordActivity::class.java)
            startActivity(intent)
        }
    }
}

- Gets references to email, password, login button, and two text links.
- On login click: validates fields are not empty, seeds demo data, finds employee by email.
- If found: passes employeeId, employeeName, role to the correct activity (Manager or Main).
- If not found: shows "Invalid email or password" toast.
- Register and ForgotPassword links start their respective activities.

